# Anthropic API key pre PM CLI (Claude Agent SDK)
ANTHROPIC_API_KEY=

# Cieľový API endpoint (build-time fallback; runtime config.json prebije)
VITE_API_BASE_URL=http://localhost:5173

# BFF origin (Vite proxy /api/* a /auth/* /me/* target). Default lokálny BFF.
VITE_BFF_ORIGIN=http://localhost:5174

# FE-side MSW fallback (bez bežiaceho BFF). Default OFF — BFF beží lokálne.
VITE_USE_MOCKS=false

# Telemetria / observability (G.3).
# Sentry DSN-y poskytuje BFF cez runtime `/config` → `observability.sentryDsn`
# (nie cez VITE_*). Tieto premenné sú LEN pre CI source-maps upload.
# `SENTRY_AUTH_TOKEN` musí byť pridaný ako GitHub repo secret — NIKDY commit.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=sdm-rewrite
SENTRY_PROJECT_PORTAL=sdm-portal
SENTRY_PROJECT_WORKSPACE=sdm-workspace
# Per-app DSN — verejný, dizajnovaný na client-side použitie. V dev / mock
# móde nech zostane prázdny (Sentry sa neinicializuje, ide do no-op módu).
VITE_SENTRY_DSN=

# BFF runtime
BFF_PORT=5174
BFF_SESSION_STORE_MODE=in-memory
BFF_REDIS_URL=
BFF_CA_SDM_URL=https://sdm-staging.example.org
BFF_CA_SDM_USE_MOCKS=true

# PM CLI log level (debug | info | warn | error)
PM_LOG_LEVEL=info
