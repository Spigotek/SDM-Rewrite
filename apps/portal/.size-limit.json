[
  {
    "name": "Portal — initial JS (entry + eagerly-loaded vendor chunks)",
    "path": [
      "dist/assets/index-*.js",
      "dist/assets/vendor-react-*.js",
      "dist/assets/vendor-i18n-*.js",
      "dist/assets/vendor-ds-*.js",
      "dist/assets/vendor-router-*.js",
      "dist/assets/vendor-state-*.js"
    ],
    "limit": "180 KB",
    "gzip": true
  },
  {
    "name": "Portal — initial CSS",
    "path": "dist/assets/index-*.css",
    "limit": "30 KB",
    "gzip": true
  },
  {
    "name": "Portal — vendor-react chunk",
    "path": "dist/assets/vendor-react-*.js",
    "limit": "70 KB",
    "gzip": true
  },
  {
    "name": "Portal — vendor-i18n chunk",
    "path": "dist/assets/vendor-i18n-*.js",
    "limit": "35 KB",
    "gzip": true
  },
  {
    "name": "Portal — vendor-ds chunk",
    "path": "dist/assets/vendor-ds-*.js",
    "limit": "35 KB",
    "gzip": true
  },
  {
    "name": "Portal — vendor-observability chunk (lazy)",
    "path": "dist/assets/vendor-observability-*.js",
    "limit": "130 KB",
    "gzip": true
  },
  {
    "name": "Portal — vendor-router chunk",
    "path": "dist/assets/vendor-router-*.js",
    "limit": "25 KB",
    "gzip": true
  },
  {
    "name": "Portal — vendor-state chunk",
    "path": "dist/assets/vendor-state-*.js",
    "limit": "20 KB",
    "gzip": true
  }
]
