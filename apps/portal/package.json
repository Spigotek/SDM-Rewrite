{
  "name": "@sdm/portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "preview": "vite preview --port 5173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "build": "vite build",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "lhci": "lhci collect --config=./lighthouserc.json && lhci assert --config=./lighthouserc.json",
    "clean": "rimraf dist .vite .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@hookform/resolvers": "3.10.0",
    "@sdm/api-client": "workspace:*",
    "@sdm/api-mocks": "workspace:*",
    "@sdm/api-types": "workspace:*",
    "@sdm/auth": "workspace:*",
    "@sdm/design-system": "workspace:*",
    "@sdm/domain": "workspace:*",
    "@sdm/i18n": "workspace:*",
    "@sentry/react": "8.55.2",
    "@tanstack/react-query": "5.100.14",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.54.2",
    "react-hotkeys-hook": "^5.3.2",
    "react-markdown": "9",
    "react-router-dom": "6.30.3",
    "rehype-sanitize": "6",
    "remark-gfm": "4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@sentry/vite-plugin": "2.23.1",
    "@size-limit/preset-app": "^12.1.0",
    "@tanstack/react-query-devtools": "5.100.14",
    "@testing-library/react": "16.1.0",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "happy-dom": "20.9.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "size-limit": "^12.1.0",
    "vite": "6.4.3",
    "vitest": "4.1.8"
  }
}
