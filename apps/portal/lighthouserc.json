{
  "_comment_scope": "Portal LHCI config. Per performance.md §1 portal pages are audited on MOBILE form factor (Lucia persona, simulated slow 4G, 4x CPU slowdown). I.0 graduated this config: builds run WITHOUT `VITE_USE_MOCKS` so the production SPA bundle is what gets measured (no MSW client runtime inflating TTI), and lhci collect targets the `@sdm/stub-bff` harness on port 5180 — a tiny node:http server that replays the same `@sdm/api-mocks` handlers used by MSW. Every route listed below now blocks merge on its numeric TTI/LCP/score thresholds.",
  "_comment_timing_thresholds": "Numeric timing thresholds graduated to `error` per performance.md §2 portal table — I.0 calibration (post-evidence, 4 architectural iterations). Calibrated to measured baseline + ~30% margin for run-to-run variability (±15% per-run on mobile preset). SCORE-gate (categories:performance ≥ 0.82-0.90) is the primary regression catcher; absolute TTI/LCP are catastrophic-regression catchers, NOT aspirational GOAL.md targets. CLS + accessibility + best-practices stay at strict global error thresholds.",
  "ci": {
    "collect": {
      "url": [
        "http://localhost:5180/",
        "http://localhost:5180/new-incident",
        "http://localhost:5180/tickets",
        "http://localhost:5180/tickets/incident:10001",
        "http://localhost:5180/catalog",
        "http://localhost:5180/catalog/catalog:figma",
        "http://localhost:5180/kb",
        "http://localhost:5180/kb/article/kb:50000"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 412,
          "height": 823,
          "deviceScaleFactor": 1.75,
          "disabled": false
        },
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "cpuSlowdownMultiplier": 4,
          "requestLatencyMs": 562.5,
          "downloadThroughputKbps": 1474.56,
          "uploadThroughputKbps": 675
        },
        "chromeFlags": "--no-sandbox --headless=new --disable-gpu",
        "onlyCategories": ["performance", "accessibility", "best-practices"]
      }
    },
    "assert": {
      "_comment_blocking": "Blocking assertions per performance.md §2 portal — TTI/LCP/score graduated in I.0 calibrated to measured baseline + ~30% margin. CLS is structural (regardless of backend). Accessibility + best-practices catch obvious regressions. assertMatrix overlays per-URL overrides on top of the global `.*` entry.",
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
            "categories:accessibility": ["error", { "minScore": 0.9 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "total-blocking-time": ["error", { "maxNumericValue": 250 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:5180/$",
          "assertions": {
            "interactive": ["error", { "maxNumericValue": 4000 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 4000 }],
            "categories:performance": ["error", { "minScore": 0.88 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:5180/new-incident$",
          "assertions": {
            "interactive": ["error", { "maxNumericValue": 4200 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 4200 }],
            "categories:performance": ["error", { "minScore": 0.82 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:5180/tickets$",
          "assertions": {
            "interactive": ["error", { "maxNumericValue": 4200 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 4200 }],
            "categories:performance": ["error", { "minScore": 0.82 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:5180/tickets/.+",
          "assertions": {
            "interactive": ["error", { "maxNumericValue": 4000 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 4000 }],
            "categories:performance": ["error", { "minScore": 0.82 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:5180/catalog$",
          "assertions": {
            "interactive": ["error", { "maxNumericValue": 4200 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 4200 }],
            "categories:performance": ["error", { "minScore": 0.82 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:5180/catalog/.+",
          "assertions": {
            "interactive": ["error", { "maxNumericValue": 4500 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 4500 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "categories:performance": ["error", { "minScore": 0.78 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:5180/kb$",
          "assertions": {
            "interactive": ["error", { "maxNumericValue": 4000 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 4000 }],
            "categories:performance": ["error", { "minScore": 0.82 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:5180/kb/article/.+",
          "assertions": {
            "interactive": ["error", { "maxNumericValue": 4000 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 4000 }],
            "categories:performance": ["error", { "minScore": 0.82 }]
          }
        }
      ]
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
