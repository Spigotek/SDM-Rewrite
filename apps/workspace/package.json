{
  "name": "@sdm/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5175 --strictPort",
    "preview": "vite preview --port 5175",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "echo \"(no tests yet — chunk 3)\" && exit 0",
    "build": "vite build",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "lhci": "lhci collect --config=./lighthouserc.json && lhci assert --config=./lighthouserc.json",
    "clean": "rimraf dist .vite .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@fullcalendar/core": "^6",
    "@fullcalendar/daygrid": "^6",
    "@fullcalendar/interaction": "^6",
    "@fullcalendar/react": "^6",
    "@fullcalendar/timegrid": "^6",
    "@sdm/api-client": "workspace:*",
    "@sdm/api-mocks": "workspace:*",
    "@sdm/api-types": "workspace:*",
    "@sdm/auth": "workspace:*",
    "@sdm/design-system": "workspace:*",
    "@sdm/domain": "workspace:*",
    "@sdm/i18n": "workspace:*",
    "@sentry/react": "8.55.2",
    "@tanstack/react-query": "5.100.14",
    "@tanstack/react-table": "8.20.6",
    "@tiptap/extension-image": "^2",
    "@tiptap/extension-link": "^2",
    "@tiptap/extension-table": "^2",
    "@tiptap/extension-table-cell": "^2",
    "@tiptap/extension-table-header": "^2",
    "@tiptap/extension-table-row": "^2",
    "@tiptap/react": "^2",
    "@tiptap/starter-kit": "^2",
    "cytoscape": "^3.32.0",
    "cytoscape-cose-bilkent": "^4.1.0",
    "isomorphic-dompurify": "^2",
    "lucide-react": "0.471.0",
    "react": "19.0.0",
    "react-cytoscapejs": "^2.0.0",
    "react-dom": "19.0.0",
    "react-hotkeys-hook": "^5.3.2",
    "react-markdown": "9",
    "react-router-dom": "6.30.3",
    "rehype-sanitize": "6",
    "remark-gfm": "4"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@sentry/vite-plugin": "2.23.1",
    "@size-limit/preset-app": "^12.1.0",
    "@tanstack/react-query-devtools": "5.100.14",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "size-limit": "^12.1.0",
    "vite": "6.4.3",
    "vite-plugin-svgr": "^4.3.0"
  }
}
