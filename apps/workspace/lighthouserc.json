{
  "_comment_scope": "Workspace LHCI config. Per performance.md §1 workspace pages are audited on DESKTOP form factor (Anna persona, 2-monitor workstation). I.0 graduated this config: builds run with VITE_USE_MOCKS=true so the MSW worker intercepts /config, /me, /me/tenants etc., and lhci collect targets the live `vite preview` server (port 5175) instead of the broken `staticDistDir` mode. Every route listed below now blocks merge on its numeric TTI/LCP/score thresholds. Heavy routes — `/changes/calendar` (FullCalendar lazy chunk) and `/cmdb/ci/:id` (Cytoscape graph lazy chunk) — carry deliberately looser per-URL overrides per performance.md §2.",
  "_comment_timing_thresholds": "Numeric timing thresholds graduated from `warn` → `error` in I.0 per performance.md §2 workspace table. `assertMatrix` carries one global entry (`.*` — CLS, a11y, best-practices) plus per-URL timing overrides. `/problems`, `/kb`, `/kb/article/:id` aren't enumerated in §2 — values chosen conservatively at the workspace queue/article baseline.",
  "ci": {
    "collect": {
      "url": [
        "http://localhost:5175/queue",
        "http://localhost:5175/tickets/incident:10001",
        "http://localhost:5175/changes",
        "http://localhost:5175/changes/calendar",
        "http://localhost:5175/changes/change:40000",
        "http://localhost:5175/problems",
        "http://localhost:5175/problems/problem:30000",
        "http://localhost:5175/cmdb",
        "http://localhost:5175/cmdb/ci/ci:60000",
        "http://localhost:5175/kb",
        "http://localhost:5175/kb/article/kb:50000"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new --disable-gpu",
        "onlyCategories": ["performance", "accessibility", "best-practices"]
      }
    },
    "assert": {
      "_comment_blocking": "Blocking assertions per performance.md §2 workspace — TTI/LCP/score graduated in I.0. The global `.*` matrix entry holds the CLS + a11y + best-practices floors; per-URL entries override timing per route. Heavier routes (calendar, ci-detail) relax their CLS + TBT inline.",
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
            "categories:accessibility": ["error", { "minScore": 0.9 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "total-blocking-time": ["error", { "maxNumericValue": 300 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:5175/queue$",
          "assertions": {
            "interactive": ["error", { "maxNumericValue": 2500 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
            "categories:performance": ["error", { "minScore": 0.85 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:5175/tickets/.+",
          "assertions": {
            "interactive": ["error", { "maxNumericValue": 2000 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 1700 }],
            "categories:performance": ["error", { "minScore": 0.85 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:5175/changes$",
          "assertions": {
            "interactive": ["error", { "maxNumericValue": 2500 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
            "categories:performance": ["error", { "minScore": 0.85 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:5175/changes/calendar$",
          "assertions": {
            "interactive": ["error", { "maxNumericValue": 3000 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "total-blocking-time": ["error", { "maxNumericValue": 400 }],
            "categories:performance": ["error", { "minScore": 0.8 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:5175/changes/change:.+",
          "assertions": {
            "interactive": ["error", { "maxNumericValue": 2000 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 1700 }],
            "categories:performance": ["error", { "minScore": 0.85 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:5175/problems$",
          "assertions": {
            "interactive": ["error", { "maxNumericValue": 2500 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
            "categories:performance": ["error", { "minScore": 0.85 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:5175/problems/problem:.+",
          "assertions": {
            "interactive": ["error", { "maxNumericValue": 2000 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 1700 }],
            "categories:performance": ["error", { "minScore": 0.85 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:5175/cmdb$",
          "assertions": {
            "interactive": ["error", { "maxNumericValue": 2500 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
            "categories:performance": ["error", { "minScore": 0.85 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:5175/cmdb/ci/.+",
          "assertions": {
            "interactive": ["error", { "maxNumericValue": 3500 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2800 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "total-blocking-time": ["error", { "maxNumericValue": 500 }],
            "categories:performance": ["error", { "minScore": 0.78 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:5175/kb$",
          "assertions": {
            "interactive": ["error", { "maxNumericValue": 2200 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 1700 }],
            "categories:performance": ["error", { "minScore": 0.88 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:5175/kb/article/.+",
          "assertions": {
            "interactive": ["error", { "maxNumericValue": 2200 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 1700 }],
            "categories:performance": ["error", { "minScore": 0.88 }]
          }
        }
      ]
    },
    "upload": { "target": "temporary-public-storage" }
  }
