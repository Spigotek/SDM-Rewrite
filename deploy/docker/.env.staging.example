# J.0 staging deploy env template — copy to .env.staging on the deploy host
# (mode 0600) and substitute real values. NEVER commit a populated .env.
#
# This file ships ONLY as a template. Real values live in operator memory
# (real_backend.md, deploy_target.md) and are written host-side.

# Image tag (matches the GHCR release: 1.1.1 — J.9 cut + J.0.1 BFF
# Dockerfile CMD hotfix on 2026-06-06).
SDM_TAG=1.1.1

# BFF CSRF — comma-separated origins the BFF will trust for state-changing
# requests. Must include both the portal (:88) and workspace (:89) front-doors.
BFF_TRUSTED_ORIGINS=http://10.11.36.21:88,http://10.11.36.21:89

# CA SDM 17.4 dev/test backend (per memory real_backend.md).
CASDM_BASE_URL=http://10.11.35.35:8050
CASDM_BASIC_AUTH_USER=vueuser
CASDM_BASIC_AUTH_PASS=__REPLACE_ME__

# /config metadata — runtime half. The build-time half (BFF_APP_VERSION,
# BFF_BUILD_ID) is baked into the image by .github/workflows/release.yml at
# tag time, so it does NOT need to be set here.
#
# BFF_PUBLIC_ORIGIN — externally-reachable BFF URL for this deploy. Surfaces
# in /config as auth.bffOrigin and (when the file omits apiBaseUrl)
# apiBaseUrl. Must match the front-door host the SPA talks to.
BFF_PUBLIC_ORIGIN=http://10.11.36.21:88
# PORTAL_PUBLIC_ORIGIN — portal app front-door (requester redirect target from the workspace SPA).
PORTAL_PUBLIC_ORIGIN=http://10.11.36.14:88
# BFF_DEPLOYED_AT — ISO-8601 timestamp of this deploy. Recommended pattern:
#   export BFF_DEPLOYED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
# before each `docker compose up -d`. When unset the BFF falls back to
# new Date().toISOString() at process start, which is close enough.
BFF_DEPLOYED_AT=
